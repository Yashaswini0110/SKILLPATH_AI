# ---------------------------------------------------------------------------
# SkillPath AI — environment template
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Application
APP_NAME=SkillPath AI
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_USER=skillpath
POSTGRES_PASSWORD=skillpath
POSTGRES_DB=skillpath
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+psycopg2://skillpath:skillpath@localhost:5435/skillpath

# Auth / JWT
# PRD §32.4: access token 15 minutes, refresh 7 days, bcrypt cost 12.
# JWT_ALGORITHM is HS256 for local development. RS256 can replace it later
# without changing token claims (sub, role, type, jti, exp).
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# CORS (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Startup
SEED_ON_STARTUP=true

# API hardening (Phase 25). Tests disable this.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Evidence aggregation (Phase 5)
SELF_DECLARATION_RELIABILITY=0.3
RESUME_RELIABILITY=0.6
EVIDENCE_CONFLICT_VARIANCE=1.0
RESUME_MAX_BYTES=5242880
RESUME_UPLOAD_DIR=var/uploads

# Skill-gap engine (Phase 6). Extra multipliers default to 1.0 so
# Gap = max(0, L_req − L_cur) × I × C × R × E.
GAP_WEIGHT_IMPORTANCE=1.0
GAP_WEIGHT_CONFIDENCE=1.0
GAP_WEIGHT_CRITICALITY=1.0
GAP_WEIGHT_EVIDENCE=1.0
GAP_CRITICAL_THRESHOLD=2.0
GAP_HIGH_THRESHOLD=1.0
GAP_MEDIUM_THRESHOLD=0.5

# Baseline recommendations (Phase 8). hashing avoids downloading Torch;
# set REC_SEMANTIC_BACKEND=minilm after installing sentence-transformers.
REC_TOP_GAP_COUNT=5
REC_RESULT_LIMIT=10
REC_SEMANTIC_BACKEND=hashing
REC_SEMANTIC_MODEL=all-MiniLM-L6-v2

# Hybrid recommendation weights (Phase 10). Each signal is in [0, 1].
REC_W_SEMANTIC=1.0
REC_W_GAP=1.0
REC_W_PREREQUISITE=1.0
REC_W_DIFFICULTY=1.0
REC_W_PREFERENCE=1.0
REC_W_COLLABORATIVE=1.0
REC_W_KG=1.0

# Project pairing (Phase 11)
REC_P_SKILLS=1.0
REC_P_PRIORITY=1.0
REC_P_DIFFICULTY=1.0
REC_P_PROFICIENCY=1.0
REC_P_DURATION=1.0
REC_P_TECHNOLOGIES=1.0
REC_P_ROLE=1.0

# Mentor matching (Phase 12)
REC_M_SKILL=1.0
REC_M_DOMAIN=1.0
REC_M_EXPERIENCE=1.0
REC_M_AVAILABILITY=1.0
REC_M_GOALS=1.0
REC_M_WORKLOAD=1.0

# Assessments (Phase 16–17)
ASSESSMENT_PASS_SCORE=0.7
ASSESSMENT_WEAK_SCORE=0.55
ASSESSMENT_STRONG_SCORE=0.90

# Neo4j knowledge graph (Phase 9). Bolt is published on 7688.
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=skillpath
NEO4J_SYNC_ON_STARTUP=true

# Job description analysis (Phase 4)
JD_WEIGHT_REQUIRED=1.0
JD_WEIGHT_PREFERRED=0.6
JD_WEIGHT_MENTIONED=0.4
JD_MAX_BYTES=5242880
JD_UPLOAD_DIR=var/uploads/job_descriptions

# Frontend (Vite; baked in at build time)
VITE_API_URL=http://localhost:8000

# Optional LLM rephrase (Phase 19). Off by default. The model only
# rewrites retrieved facts; it is not the ranking engine.
# Get a key from https://build.nvidia.com/openai/gpt-oss-20b
LLM_ENABLED=false
LLM_API_KEY=
# NVIDIA_API_KEY is also accepted as an alias for LLM_API_KEY.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=90
